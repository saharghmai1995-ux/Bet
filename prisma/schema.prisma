generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// سیستم هوشمند پیش‌بینی و مدیریت سرمایه فوتبال
// Multi-Agent Football Prediction & Capital Management System
// ─────────────────────────────────────────────────────────────

// لایه ۱: پایپ‌لاین گردآوری داده‌ها (Data Ingestion)
model Match {
  id        String   @id @default(cuid())
  league    String
  homeTeam  String
  awayTeam  String
  kickoff   DateTime

  // قدرت تیم‌ها (ضریب نسبت به میانگین لیگ)
  homeAttack  Float
  homeDefense Float
  awayAttack  Float
  awayDefense Float

  // امتیاز الو
  homeElo Int
  awayElo Int

  // آمار پیشرفته
  homeXg        Float
  awayXg        Float
  homePpda      Float
  awayPpda      Float
  homeFieldTilt Float
  awayFieldTilt Float
  homeForm      String // مثال: WWDLW
  awayForm      String

  // شرایط باخبری و محیطی
  weather        String
  homeAbsence    String?
  awayAbsence    String?
  homeMotivation String?
  awayMotivation String?
  tacticalNote   String?

  // ضرایب بازار (با حاشیه سود سایت) — خط اجماعی Soft Book
  oddsHome   Float
  oddsDraw   Float
  oddsAway   Float
  oddsOver25 Float
  oddsUnder25 Float
  odds1x     Float

  // ─── افزوده‌های سطح اول (Institutional-Grade) ───
  // npxG تفکیک‌شده بر اساس وضعیت بازی (Game State) — پرهیز از «بت‌پرستی xG خام»
  homeNpxgLevel    Float? // npxG وقتی بازی مساوی است
  homeNpxgLeading  Float? // npxG وقتی جلو است (شامل وقت تلف‌شده — کیفیت پایین‌تر)
  homeNpxgTrailing Float? // npxG وقتی عقب است
  awayNpxgLevel    Float?
  awayNpxgLeading  Float?
  awayNpxgTrailing Float?
  // کرنر و شرایط محیطی
  homeCornersFor    Float?
  homeCornersAgainst Float?
  awayCornersFor    Float?
  awayCornersAgainst Float?
  awayTravelKm      Int?    // فاصله پروازی میهمان
  homeRestDays      Int?    // فشردگی تقویم
  awayRestDays      Int?
  // داور و ترکیب
  refereeId        String?
  lineupAnnounced  Boolean @default(false) // اعلام ترکیب T-60
  lineupShockHome  Float?  // دلتا قدرت میزبان (−۱ تا ۱) پس از اعلام ترکیب
  lineupShockAway  Float?
  // نتیجه نهایی (برای کالیبراسیون بریر)
  homeGoals Int?
  awayGoals Int?

  status    String         @default("UPCOMING") // UPCOMING | ANALYZED | LIVE | FINISHED
  referee   Referee?       @relation(fields: [refereeId], references: [id])
  players   Player[]
  odds      OddsRecord[]
  analyses  AgentAnalysis[]
  createdAt DateTime       @default(now())
}

// ─── ارزش‌گذاری تک‌تک بازیکنان (VAEP & xT) — به جای «نام تیم» ───
model Player {
  id        String  @id @default(cuid())
  match     Match   @relation(fields: [matchId], references: [id])
  matchId   String
  side      String  // HOME | AWAY
  name      String
  position  String  // GK | DEF | MID | FW
  xT        Float   // Expected Threat per 90
  vaep      Float   // Value of Actions per 90 (می‌تواند منفی باشد)
  status    String  @default("FIT") // FIT | INJURED | SUSPENDED | DOUBTFUL
  isKey     Boolean @default(false) // بازیکن کلیدی (تاثیر بالای ترکیب)
}

// ─── پروفایلر داور (Referee Micro-Profiler) ───
model Referee {
  id             String  @id @default(cuid())
  name           String  @unique
  yellowPerMatch Float
  penPerMatch    Float
  foulsPerMatch  Float
  strictness     String  // LENIENT | AVERAGE | STRICT
  note           String?
  matches        Match[]
}

// ─── ردیابی ضرایب چند بوک‌میکر (Pinnacle Sharp Line در برابر Soft Books) ───
model OddsRecord {
  id        String   @id @default(cuid())
  match     Match    @relation(fields: [matchId], references: [id])
  matchId   String
  bookmaker String   // PINNACLE | SOFT_A | SOFT_B
  oddsHome  Float
  oddsDraw  Float
  oddsAway  Float
  oddsOver25  Float
  oddsUnder25 Float
  oddsCornersOver95  Float
  oddsCornersUnder95 Float
  updatedAt DateTime @updatedAt
}

// ─── حافظه کالیبراسیون: امتیاز بریر پس از بازی + اصلاح خودکار ───
model CalibrationLog {
  id            String   @id @default(cuid())
  matchLabel    String
  league        String
  pick          String   // بازار پیش‌بینی‌شده
  predictedProb Float
  outcome       String   // WIN | LOSS
  brier         Float    // (p − o)²
  lesson        String?  // درس استخراج‌شده توسط ایجنت بازرس
  createdAt     DateTime @default(now())
}

// خروجی ایجنت تحلیلگر ارشد (لایه ۳)
model AgentAnalysis {
  id      String @id @default(cuid())
  match   Match  @relation(fields: [matchId], references: [id])
  matchId String

  // خروجی کامل ایجنت (JSON)
  payload String

  // احتمالات واقعی (True Probability) — نرمال‌شده
  pHome   Float
  pDraw   Float
  pAway   Float
  pOver25 Float
  pUnder25 Float

  // ارزش مورد انتظار (+EV) در برابر ضرایب سایت
  evHome   Float
  evDraw   Float
  evAway   Float
  evOver25 Float
  evUnder25 Float

  bestMarket String
  bestEv     Float
  confidence Float
  riskFlag   String @default("OK")
  source     String @default("LLM") // LLM | ENGINE_FALLBACK
  createdAt  DateTime @default(now())
}

// خروجی ایجنت مدیریت ریسک (لایه ۴): تیپ‌های مکمل
model TipSet {
  id       String  @id @default(cuid())
  label    String // تیپ A (بازی باز) / تیپ B (بازی بسته)
  strategy String // EQUAL_PROFIT | HEDGE_MAIN | AGGRESSIVE
  mode     String // SINGLE_MATCH | TWO_MATCH
  legs     String // JSON: [{match, market, selection, odds, prob}]
  totalOdds Float
  stake     Float
  potentialReturn Float
  guaranteedProfit Float
  coverageProb    Float
  coverageOk      Boolean
  trapRisk        String // NONE | WARNING | CRITICAL
  jointLossProb   Float? // احتمال باخت همزمان از شبیه‌سازی مونت‌کارلو
  meta            String? // JSON: {kelly: {fA,fB,growth}, mc: {corr, sims}, jointStates}
  batchId  String?
  notes    String?
  createdAt DateTime @default(now())
}

// لایه ۵: بک‌تستینگ و ارزیابی CLV
model BacktestRun {
  id        String @id @default(cuid())
  totalBets Int
  wins      Int
  roi       Float
  strikeRate Float
  avgClv    Float
  positiveClvRate Float
  maxDrawdown Float
  finalEquity Float
  equityCurve String // JSON: [{i, equity, clv}]
  config     String // JSON config
  createdAt  DateTime @default(now())
}
