generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// سیستم هوشمند پیش‌بینی و مدیریت سرمایه فوتبال
// Multi-Agent Football Prediction & Capital Management System
// ─────────────────────────────────────────────────────────────

// لایه ۱: پایپ‌لاین گردآوری داده‌ها (Data Ingestion)
model Match {
  id        String   @id @default(cuid())
  league    String
  homeTeam  String
  awayTeam  String
  kickoff   DateTime

  // قدرت تیم‌ها (ضریب نسبت به میانگین لیگ)
  homeAttack  Float
  homeDefense Float
  awayAttack  Float
  awayDefense Float

  // امتیاز الو
  homeElo Int
  awayElo Int

  // آمار پیشرفته
  homeXg        Float
  awayXg        Float
  homePpda      Float
  awayPpda      Float
  homeFieldTilt Float
  awayFieldTilt Float
  homeForm      String // مثال: WWDLW
  awayForm      String

  // شرایط باخبری و محیطی
  weather        String
  homeAbsence    String?
  awayAbsence    String?
  homeMotivation String?
  awayMotivation String?
  tacticalNote   String?

  // ضرایب بازار (با حاشیه سود سایت) — خط اجماعی Soft Book
  oddsHome   Float
  oddsDraw   Float
  oddsAway   Float
  oddsOver25 Float
  oddsUnder25 Float
  odds1x     Float

  // ─── افزوده‌های سطح اول (Institutional-Grade) ───
  // npxG تفکیک‌شده بر اساس وضعیت بازی (Game State) — پرهیز از «بت‌پرستی xG خام»
  homeNpxgLevel    Float? // npxG وقتی بازی مساوی است
  homeNpxgLeading  Float? // npxG وقتی جلو است (شامل وقت تلف‌شده — کیفیت پایین‌تر)
  homeNpxgTrailing Float? // npxG وقتی عقب است
  awayNpxgLevel    Float?
  awayNpxgLeading  Float?
  awayNpxgTrailing Float?
  // کرنر و شرایط محیطی
  homeCornersFor    Float?
  homeCornersAgainst Float?
  awayCornersFor    Float?
  awayCornersAgainst Float?
  awayTravelKm      Int?    // فاصله پروازی میهمان
  homeRestDays      Int?    // فشردگی تقویم
  awayRestDays      Int?
  // داور و ترکیب
  refereeId        String?
  lineupAnnounced  Boolean @default(false) // اعلام ترکیب T-60
  lineupShockHome  Float?  // دلتا قدرت میزبان (−۱ تا ۱) پس از اعلام ترکیب
  lineupShockAway  Float?
  // نتیجه نهایی (برای کالیبراسیون بریر)
  homeGoals Int?
  awayGoals Int?

  // ─── v4.0 — تلهمتری زنده چند-API (ESPN / TheSportsDB / Open-Meteo / The Odds API) ───
  externalId      String?  @unique   // شناسه رخداد ESPN برای همگام‌سازی idempotent
  dataSource      String   @default("SEED") // SEED | ESPN | SPORTSDB
  homeLogo        String?            // لوگوی رسمی تیم میزبان (ESPN)
  awayLogo        String?            // لوگوی رسمی تیم میهمان (ESPN)
  venueName       String?            // نام ورزشگاه
  venueCity       String?            // شهر ورزشگاه (برای مختصات آب‌وهوا)
  refereeName     String?            // داور اعلام‌شده (ESPN summary)
  weatherTemp     Float?             // دمای لحظه‌ای ورزشگاه (سانتی‌گراد)
  weatherWind     Float?             // سرعت باد (km/h)
  weatherPrecip   Float?             // بارش (mm)
  weatherAdjusted Boolean @default(false) // تعدیل جوی −۸٪ روی λ
  oddsSource      String  @default("ENGINE") // ENGINE | ESPN_DRAFTKINGS | ODDS_API
  oddsFetchedAt   DateTime?           // آخرین به‌روزرسانی ضرایب زنده

  // ─── v6.0 — راستی‌آزمایی ۱۰۰٪ از جدول رسمی رده‌بندی ESPN (Standings API بدون کلید) ───
  homeTeamId      String?   // شناسه رسمی ESPN تیم میزبان (برای Roster API واقعی)
  awayTeamId      String?   // شناسه رسمی ESPN تیم میهمان
  homeRank        Int?      // رتبه واقعی میزبان در جدول فصل جاری
  homeGF          Int?      // گل زده واقعی فصل میزبان (pointsFor)
  homeGA          Int?      // گل خورده واقعی فصل میزبان (pointsAgainst)
  homeGP          Int?      // بازی انجام‌شده واقعی فصل میزبان (gamesPlayed)
  awayRank        Int?      // رتبه واقعی میهمان
  awayGF          Int?
  awayGA          Int?
  awayGP          Int?
  leagueTeamAvg   Float?    // میانگین گل هر تیم در هر بازی لیگ (از جدول واقعی فصل)
  statsSource     String?   // ESPN_STANDINGS | RECORD_FALLBACK
  statsFetchedAt  DateTime? // زمان دقیق آخرین واکشی جدول رده‌بندی

  // ─── v9.0 — موتور مهندسی معکوس ضرایب بوک‌میکر (Reverse-Poisson Market-Implied λ) ───
  lambdaMarketHome Float?  // λ میزبان استخراج‌شده از حل معکوس پواسون روی ضرایب بازار
  lambdaMarketAway Float?  // λ میهمان استخراج‌شده از بازار
  lambdaFitError   Float?  // خطای Least Squares برازش ماتریس بازار (کیفیت حل)
  lambdaSource     String? // MARKET_HYBRID (۶۵٪ بازار + ۳۵٪ آمار × کالیبراسیون) | STATS_ONLY

  status    String         @default("UPCOMING") // UPCOMING | ANALYZED | LIVE | FINISHED | ARCHIVED
  referee   Referee?       @relation(fields: [refereeId], references: [id])
  players   Player[]
  odds      OddsRecord[]
  analyses  AgentAnalysis[]
  createdAt DateTime       @default(now())
}

// ─── ارزش‌گذاری تک‌تک بازیکنان (VAEP & xT) — به جای «نام تیم» ───
model Player {
  id        String  @id @default(cuid())
  match     Match   @relation(fields: [matchId], references: [id])
  matchId   String
  side      String  // HOME | AWAY
  name      String
  position  String  // GK | DEF | MID | FW
  xT        Float   // Expected Threat per 90
  vaep      Float   // Value of Actions per 90 (می‌تواند منفی باشد)
  status    String  @default("FIT") // FIT | INJURED | SUSPENDED | DOUBTFUL
  isKey     Boolean @default(false) // بازیکن کلیدی (تاثیر بالای ترکیب)
}

// ─── پروفایلر داور (Referee Micro-Profiler) ───
model Referee {
  id             String  @id @default(cuid())
  name           String  @unique
  yellowPerMatch Float
  penPerMatch    Float
  foulsPerMatch  Float
  strictness     String  // LENIENT | AVERAGE | STRICT
  note           String?
  matches        Match[]
}

// ─── ردیابی ضرایب چند بوک‌میکر (Pinnacle Sharp Line در برابر Soft Books) ───
model OddsRecord {
  id        String   @id @default(cuid())
  match     Match    @relation(fields: [matchId], references: [id])
  matchId   String
  bookmaker String   // PINNACLE | SOFT_A | SOFT_B
  bookmakerLabel String? // v4.0 — نام واقعی بوک‌میکر فید زنده
  oddsHome  Float
  oddsDraw  Float
  oddsAway  Float
  oddsOver25  Float
  oddsUnder25 Float
  oddsCornersOver95  Float
  oddsCornersUnder95 Float
  updatedAt DateTime @updatedAt
}

// ─── حافظه کالیبراسیون: امتیاز بریر پس از بازی + اصلاح خودکار ───
model CalibrationLog {
  id            String   @id @default(cuid())
  matchLabel    String
  league        String
  pick          String   // بازار پیش‌بینی‌شده
  predictedProb Float
  outcome       String   // WIN | LOSS
  brier         Float    // (p − o)²
  lesson        String?  // درس استخراج‌شده توسط ایجنت بازرس
  createdAt     DateTime @default(now())
}

// خروجی ایجنت تحلیلگر ارشد (لایه ۳)
model AgentAnalysis {
  id      String @id @default(cuid())
  match   Match  @relation(fields: [matchId], references: [id])
  matchId String

  // خروجی کامل ایجنت (JSON)
  payload String

  // احتمالات واقعی (True Probability) — نرمال‌شده
  pHome   Float
  pDraw   Float
  pAway   Float
  pOver25 Float
  pUnder25 Float

  // ارزش مورد انتظار (+EV) در برابر ضرایب سایت
  evHome   Float
  evDraw   Float
  evAway   Float
  evOver25 Float
  evUnder25 Float

  bestMarket String
  bestEv     Float
  confidence Float
  riskFlag   String @default("OK")
  source     String @default("LLM") // LLM | ENGINE_FALLBACK
  createdAt  DateTime @default(now())
}

// خروجی ایجنت مدیریت ریسک (لایه ۴): تیپ‌های مکمل
model TipSet {
  id       String  @id @default(cuid())
  label    String // تیپ A (بازی باز) / تیپ B (بازی بسته)
  strategy String // EQUAL_PROFIT | HEDGE_MAIN | AGGRESSIVE
  mode     String // SINGLE_MATCH | TWO_MATCH
  legs     String // JSON: [{match, market, selection, odds, prob}]
  totalOdds Float
  stake     Float
  potentialReturn Float
  guaranteedProfit Float
  coverageProb    Float
  coverageOk      Boolean
  trapRisk        String // NONE | WARNING | CRITICAL
  jointLossProb   Float? // احتمال باخت همزمان از شبیه‌سازی مونت‌کارلو
  meta            String? // JSON: {kelly: {fA,fB,growth}, mc: {corr, sims}, jointStates}
  batchId  String?
  notes    String?
  createdAt DateTime @default(now())
}

// لایه ۵: بک‌تستینگ و ارزیابی CLV
model BacktestRun {
  id        String @id @default(cuid())
  totalBets Int
  wins      Int
  roi       Float
  strikeRate Float
  avgClv    Float
  positiveClvRate Float
  maxDrawdown Float
  finalEquity Float
  equityCurve String // JSON: [{i, equity, clv}]
  config     String // JSON config
  createdAt  DateTime @default(now())
}

// ─── v7.0 — دفتر کارنامه: کارت‌های صادرشده (تیپ A + تیپ B داچینگ) ───
// پس از FT شدن بازی در ESPN Scoreboard، تسویه ۱۰۰٪ خودکار انجام می‌شود:
//   WON_A (برد تیپ A) · WON_B (برد تیپ B) · DOUBLE_WIN (جکپات دو برد)
//   MIDDLE_TRAP (تله میانی — باخت صادقانه) · MANUAL_REVIEW (بازار خارج اسکوربورد)
model IssuedSlip {
  id         String  @id @default(cuid())
  hash       String  @unique // SHA-256 سند راستی‌آزمایی کارت
  externalId String? // شناسه رخداد ESPN (espn-<slug>-<id>) برای تطبیق تسویه
  matchId    String? // شناسه داخلی Match
  league     String
  homeTeam   String
  awayTeam   String
  kickoff    DateTime

  labelA String // شرح تیپ A
  labelB String // شرح تیپ B
  legsA  String // JSON: [{key, matchExternalId?, matchLabel}] شرط‌های تیپ A
  legsB  String // JSON: شرط‌های تیپ B
  oddsA  Float  // ضریب نهایی تیپ A
  oddsB  Float  // ضریب نهایی تیپ B
  stakeA Float  // مبلغ داچینگ تیپ A (مجموع استیک = ۱۰۰ واحد)
  stakeB Float  // مبلغ داچینگ تیپ B
  cellsA String? // JSON: خانه‌های پوشش تیپ A روی ماتریس ۶×۶
  cellsB String?
  guaranteedProfit Float // سود تضمینی داچینگ (در پوشش)
  marginPct        Float
  archetype        String? // نام کوتاه الگوی متعامد
  archetypeCode    String? // v9.0 — کد الگو (A1..A5) برای حلقه کالیبراسیون
  espnUrl          String? // لینک راستی‌آزمایی رسمی ESPN

  // ─── v9.0 — حلقه فعال کالیبراسیون + خط لوله خودکار سرور ───
  lambdaHome Float? // λ ترکیبی نهایی مدل در لحظه صدور (مبنای انحراف گلزنی لیگ)
  lambdaAway Float?
  supervisorApproved Boolean @default(true) // فقط کارت‌های تایید سوپروایزر به تلگرام می‌روند
  autoIssued         Boolean @default(false) // ثبت خودکار سرور (Zero-Click Multi-Day Pipeline)

  // ─── v11.0 — دفتر سایه (Shadow Ledger): سناریوی.counterfactual وتوها ───
  supervisorScore   Float?  // امتیاز خام UtilityScore سوپروایزر در لحظه تصمیم
  vetoReason        String? // دلیل وتو — فقط برای کارت‌های سایه (supervisorApproved=false)
  jointLossRiskPct  Float?  // ٪ ریسک باخت همزمان (jointStates.bothLose × ۱۰۰) در لحظه صدور
  doubleWinProbPct  Float?  // ٪ برد طلایی همزمان (jointStates.bothWin × ۱۰۰) در لحظه صدور

  // ─── v18.0 — سطح تاج (Two-Tier Crown System) ───
  // GOLD = تاج طلایی سطح ۱ (استیک کامل ۱۰۰u) | SILVER_SHADOW = تاج نقره‌ای سطح ۲
  // (شکارچی آلفای دفتر سایه — استیک نصف ۵۰u Half-Kelly) | null = نسخه‌های قدیمی/بدون سطح‌بندی
  crownTier String?

  // ─── v10.0 — ارزش عددی نسبت به خط پیناکل (همیشه عدد دارد) ───
  pinnacleOddsA Float?   // خط شارپ واقعی پیناکل برای تیپ A (وقتی فید در دسترس باشد)
  pinnacleOddsB Float?
  edgeA Float?           // ارزش عددی مدل: (prob×odds−۱)×۱۰۰ در برابر خط مرجع
  edgeB Float?
  edgeSourceA String?    // PINNACLE | MARKET_FAIR
  edgeSourceB String?
  modelProbA Float?      // احتمال مدل برای تیپ A در لحظه صدور
  modelProbB Float?

  // ─── v13.0 — افراز مجزا خطوط تولید (Disjoint Product-Line Partition) ───
  // SINGLE = تک‌بازی دوهج (خط ۱) | COMBO = میکس ۲/۳ تایی (خط ۲) | SNIPER = تک‌تیرانداز (خط ۳)
  // هر کارت فقط و فقط در یکی از سه خط تولید شمرده می‌شود — دوباره‌شماری صفر.
  productLine String @default("SINGLE")

  // ─── v13.2 — کارت بازخوانی (Retro Card) ───
  // بازی‌ای که هنگام صدور کارت از قبل FT شده بود (خط لوله چندروزه) — هرگز پیش از بازی
  // صادر و تایید/منتشر نشده است؛ فقط تسویه کاغذی تحلیلی برای یادگیری دکترین.
  // از وین‌ریت واقعی کانال، اعلام نتایج تلگرام و دسته الف کارنامه مستثناست.
  retroIssued Boolean @default(false)

  // ─── v10.0 — پنجره زمانی طلایی ثبت ضریب (Optimal Odds Timing Window) ───
  tipKindA String?       // FAVORITE | TOTALS | UNDERDOG
  tipKindB String?
  timingWindowA String?  // EARLY_FAVORITE | LINEUP_SHOCK | LATE_UNDERDOG
  timingWindowB String?
  timingStartA DateTime? // شروع مطلق پنجره (ساعت پیشنهادی ثبت)
  timingEndA DateTime?
  timingStartB DateTime?
  timingEndB DateTime?

  // ─── تسویه خودکار پس از FT ───
  status     String  @default("PENDING") // PENDING | LIVE | WON_A | WON_B | DOUBLE_WIN | MIDDLE_TRAP | MANUAL_REVIEW | VOID
  homeGoals  Int?
  awayGoals  Int?
  profitA    Float?  // سود/زیان تیپ A پس از تسویه
  profitB    Float?
  netProfit  Float?  // سود خالص کل داچینگ
  settledAt  DateTime?
  settleNote String?
  // v19.0 — سپر توقف ضرر زنده (In-Play Stop-Loss Shield): تله میانی در دقیقه ۶۵ با
  // کش‌اوت زنده ۵۵٪ سرمایه نجات داده می‌شود → زیان خالص -۴۵ به‌جای -۱۰۰
  stopLossShield Boolean @default(false)

  // ─── وضعیت انتشار تلگرام ───
  telegramCard   Boolean @default(false) // کارت کامل منتشر شد
  telegramTeaser Boolean @default(false) // تیزر (تیپ B سانسور) منتشر شد
  telegramResult Boolean @default(false) // نتیجه پس از FT منتشر شد

  createdAt DateTime @default(now())
  outbox    TelegramOutbox[]
}

// ─── v7.0 — آرشیو پیام‌های ارسالی کانال تلگرام VIP ───
model TelegramOutbox {
  id     String  @id @default(cuid())
  slip   IssuedSlip? @relation(fields: [slipId], references: [id])
  slipId String?
  kind   String  // CARD | TEASER | RESULT | CONFIG_TEST | WINRATE
  ok     Boolean
  detail String? // شناسه پیام تلگرام یا متن خطا
  createdAt DateTime @default(now())
  // v19.0 — کلید ادعای اتمی broadcast (insert-first claim):
  // هر پست کانال قبل از ارسال یک ردیف با dedupeKey یکتا می‌سازد؛ شکست INSERT =
  // ادعای قبلی موجود → بدون ارسال. اتمیک در سطح SQLite و ایمن در برابر هر تعداد
  // پردازه/ری‌استارت (ریشه ریشه‌ای باگ «ارسال پیام‌های تکراری به کانال عمومی»).
  dedupeKey String? @unique
}

// ─── v7.0 — تنظیمات سراسری سمت سرور (توکن بات تلگرام و ...) ───
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── v10.0 — ژورنال تسویه: ثبت درس‌آموزی هر تسویه خودکار (Journal of Record) ───
model SettlementJournal {
  id            String   @id @default(cuid())
  slipId        String?  // شناسه کارت تسویه‌شده
  slipHash      String?  // هش راستی‌آزمایی
  league        String
  matchLabel    String
  status        String   // WON_A | WON_B | DOUBLE_WIN | MIDDLE_TRAP | VOID | MANUAL_REVIEW
  homeGoals     Int?
  awayGoals     Int?
  netProfit     Float?
  archetypeCode String?
  timingWindow  String?  // پنجره زمانی پیشنهادی در لحظه صدور
  lambdaHome    Float?
  lambdaAway    Float?
  lesson        String   // درس خودکار استخراج‌شده از این نتیجه
  createdAt     DateTime @default(now())
}

// ─── v10.0 — دفتر دکترین: قوانین عددی آموخته‌شده از کارنامه (Doctrine Registry) ───
model DoctrineEntry {
  id          String   @id @default(cuid())
  kind        String   // LEAGUE_LAMBDA | ARCHETYPE | TIMING_WINDOW
  scope       String   // نام لیگ / کد الگو (A1..A5) / کلید پنجره زمانی
  summary     String   // متن خوانا دکترین
  numericRule String   // JSON بردار عددی قانون (مصرف موتور و سوپروایزر)
  multiplier  Float    // ضریب اصلاحی اعمالی (مثلاً λ ×۰.۹۴)
  sampleSize  Int      // تعداد نمونه تسویه‌شده پشت این دکترین
  netProfit   Float    // سود خالص تجمعی نمونه‌ها (واحد)
  winRate     Float    // وین‌ریت نمونه‌ها (٪)
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}
